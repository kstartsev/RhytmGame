{
	"version": "2.0.0",
	"tasks": [
    {
      "label": "build-game",
      "type": "shell",
      "command": "make",
      "args": [
        "game"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}
